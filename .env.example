# FastAPI
SECRET_KEY=your-secret-key
JWT_SECRET_KEY=your-jwt-secret-key

# 数据库：二选一，每个部署只使用一种数据库。默认仍为 PostgreSQL。
# 未配置或配置错误时按 PostgreSQL 连接，不会自动回退其他数据库。
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/quiz

# SQLite 单机部署示例（绝对路径必须指向持久化文件）：
# DATABASE_URL=sqlite:////var/lib/quiz-app/quiz.db
# 可选：锁文件目录，默认放在数据库文件同级的 .db-locks/ 下，必须与 API/worker 一致。
# SQLITE_LOCK_DIR=/var/lib/quiz-app/.db-locks

# AI 翻译与解析
AI_API_BASE_URL=https://api.openai.com
AI_API_KEY=your-api-key
AI_MODEL=gpt-4o-mini

# Algolia 搜索（用于 import_iapp_glossary.py）
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_API_KEY=your-algolia-api-key
ALGOLIA_INDEX=all
